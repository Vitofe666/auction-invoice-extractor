# OpenAI API key with access to multimodal models
OPENAI_API_KEY=sk-...

# Optional: defaults shown
OPENAI_MODEL=gpt-4.1
PORT=3001
SCRAPE_TIMEOUT_MS=45000
MAX_IMAGES_PER_LOT=8
MAX_URLS_PER_REQUEST=5

# Frontend setting (only needed if frontend runs on different host)
VITE_BACKEND_URL=http://localhost:3001
