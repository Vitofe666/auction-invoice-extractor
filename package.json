{
  "name": "auction-invoice-extractor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:server": "tsx backend/auctionReportServer.ts",
    "start:server": "node --import tsx backend/auctionReportServer.ts",
    "test:dates": "node tests/run-tests.cjs",
    "test:ficha": "node --import tsx --test tests/fichaExport.test.ts",
    "typecheck:ficha": "tsc --noEmit -p tsconfig.ficha.json",
    "test:ficha:layout": "FICHA_EXPORT_DIR=tmp/ficha node --import tsx --test tests/fichaExport.test.ts && python3 tests/verify-ficha-layout.py"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@google/genai": "^1.27.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.14",
    "cors": "^2.8.5",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "image-size": "^2.0.4",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.12.2",
    "pdfkit": "^0.17.2",
    "playwright": "^1.55.0",
    "postcss": "^8.4.30",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "3.4.3",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.2"
  }
}
